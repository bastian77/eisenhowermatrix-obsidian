{
	"name": "eisenhower-matrix",
	"version": "0.0.8",
	"description": "Create and manage tasks from your vault and display them in an Eisenhower matrix.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint \"src/**/*.{ts,tsx}\" main.ts"
	},
	"keywords": ["obsidian", "obsidian-plugin", "eisenhower-matrix", "productivity", "task-management"],
	"author": "Bastian Ibach",
	"license": "MIT",
	"dependencies": {
		"preact": "^10.19.0"
	},
	"devDependencies": {
		"@types/node": "^18.0.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.17.3",
		"eslint": "^9.0.0",
		"eslint-plugin-obsidianmd": "^0.1.9",
		"globals": "^16.5.0",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "^5.4.0",
		"typescript-eslint": "^8.0.0"
	}
}
